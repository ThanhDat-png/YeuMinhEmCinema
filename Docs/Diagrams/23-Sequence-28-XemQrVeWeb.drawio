        <mxCell id="step_21" value="2: Id() -&gt; lấy MaTaiKhoan từ Claims Cookie" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;spacingLeft=6;verticalAlign=middle;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
