        </mxCell>
        <mxCell id="step_23" value="4: SELECT v.MaVe FROM Ve v JOIN DonHang d ... JOIN KhachHang k WHERE k.MaTaiKhoan=@Id AND k.DangHoatDong=1 AND d.TrangThai=&apos;DA_THANH_TOAN&apos; AND v.TrangThai IN(&apos;HIEU_LUC&apos;,&apos;DA_SU_DUNG&apos;)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="735" y="404" as="sourcePoint" />
            <mxPoint x="1045" y="404" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step_24" value="5: return MaVe (hoặc rỗng nếu không hợp lệ / khác chủ)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
