        <mxCell id="step_22" value="3: Ve(maTaiKhoan, maVeGuid)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
