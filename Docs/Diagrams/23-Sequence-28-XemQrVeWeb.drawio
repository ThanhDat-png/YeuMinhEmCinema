        <mxCell id="step_20" value="1: GET /Don/Qr/{id} (tải ảnh QR vé trên trang chi tiết đơn)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
