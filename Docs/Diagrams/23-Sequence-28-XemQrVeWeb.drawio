        <mxCell id="div_26" value="[Vé hợp lệ thuộc khách hàng hiện tại]" style="line;strokeWidth=1;dashed=1;strokeColor=#000000;direction=east;fontFamily=Arial;fontSize=11;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
