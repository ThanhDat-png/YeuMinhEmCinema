        <mxCell id="step_26" value="Ném SqlException -&gt; nạp lại sơ đồ ghế (Tai(model))" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
