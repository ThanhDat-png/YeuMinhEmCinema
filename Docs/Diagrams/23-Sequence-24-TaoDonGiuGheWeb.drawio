        </mxCell>
        <mxCell id="step_22" value="5: BEGIN TRAN; sp_getapplock(N&apos;YMC_Booking_Write&apos;); kiểm tra trạng thái ghế" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;spacingLeft=6;verticalAlign=middle;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
