        <mxCell id="step_18" value="1: POST /DatVe/GiuGhe (DatVeModel: MaSuatChieu, Ghe[1..8], Fnb, MaYeuCau)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
