        <mxCell id="step_21" value="4: EXEC dbo.sp_YMC_TaoDonGiuGhe @NguoiThucHien=@MaTaiKhoan, @MaYeuCau, @MaSuatChieu, @Kenh=&apos;WEB&apos;, @DanhSachGhe, @DanhSachFnb" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
