        <mxCell id="step_25" value="6: THROW 50310, N&apos;Ghế đã có người giữ hoặc đã bán.&apos;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
