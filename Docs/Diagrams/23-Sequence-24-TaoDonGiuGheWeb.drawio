        <mxCell id="step_27" value="return View(&apos;Ghe&apos;, model) kèm thông báo lỗi ModelState" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
