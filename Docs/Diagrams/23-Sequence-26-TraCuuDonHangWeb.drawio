        <mxCell id="step_19" value="1: GET /Don?trangThai={tt}&amp;trang={p}" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
