          </mxGeometry>
        </mxCell>
        <mxCell id="step_22" value="5: BEGIN TRAN; kiểm tra quyền FNB_QUAN_LY, PhienBan, thành phần lẻ hợp lệ" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;spacingLeft=6;verticalAlign=middle;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
