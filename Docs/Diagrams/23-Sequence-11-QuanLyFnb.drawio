            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="step_23" value="6: IF @MaSanPham IS NULL INSERT FnbSanPham; ELSE UPDATE FnbSanPham" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;spacingLeft=6;verticalAlign=middle;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
