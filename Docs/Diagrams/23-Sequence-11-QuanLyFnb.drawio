        <mxCell id="step_18" value="1: Nhập (maHang, tenSanPham, nhom, kichCo, donGia, dangBan, _parts) &amp; Click Lưu" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
