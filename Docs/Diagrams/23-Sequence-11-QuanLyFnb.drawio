        <mxCell id="step_21" value="4: EXEC dbo.sp_YMC_AdminLuuFnb @NguoiThucHien, @MaSanPham, @MaHang, @TenSanPham, ..., @ThanhPhan, @PhienBan" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
