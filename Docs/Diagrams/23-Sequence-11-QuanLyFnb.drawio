        <mxCell id="step_20" value="3: LuuFnb(ma, code, ten, nhom, size, gia, ban, thanhPhanTvp, phienBan)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
