            <mxPoint x="1045" y="556" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1083" y="514" />
              <mxPoint x="1083" y="556" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="step_24" value="7: DELETE FnbComboChiTiet WHERE MaCombo=@Ma; INSERT FnbComboChiTiet từ TVP; COMMIT" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;spacingLeft=6;verticalAlign=middle;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
