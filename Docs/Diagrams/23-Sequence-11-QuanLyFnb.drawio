        </mxCell>
        <mxCell id="step_19" value="2: Kiểm tra maHang/ten không rỗng, donGia &gt; 0 (nếu Combo phải có thành phần)" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;spacingLeft=6;verticalAlign=middle;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
