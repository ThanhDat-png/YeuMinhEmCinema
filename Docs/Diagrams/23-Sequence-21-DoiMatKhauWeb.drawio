        <mxCell id="step_26" value="6: EXEC dbo.sp_YMC_DoiMatKhau @MaTaiKhoan, @MatKhauCu, @MatKhauMoiHash" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
