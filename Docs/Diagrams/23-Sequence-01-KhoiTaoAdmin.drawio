            <mxPoint x="425" y="354" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step_25" value="6: Bật btnKhoiTaoAdmin, hiển thị hướng dẫn khởi tạo" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;spacingLeft=6;verticalAlign=middle;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
