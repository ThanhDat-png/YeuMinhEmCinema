        <mxCell id="step_20" value="1: MoForm() [FormDangNhap_Shown]" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="115" y="178" as="sourcePoint" />
            <mxPoint x="425" y="178" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step_21" value="2: DaCoAdmin()" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
