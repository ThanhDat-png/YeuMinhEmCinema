            <mxPoint x="115" y="652" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step_31" value="9: KhoiTaoAdmin(tenDangNhap, matKhau)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="425" y="738" as="sourcePoint" />
            <mxPoint x="735" y="738" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step_32" value="10: TaoHash(matKhau)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="735" y="782" as="sourcePoint" />
            <mxPoint x="1045" y="782" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step_33" value="11: Sinh Salt ngẫu nhiên + Băm PBKDF2 (PasswordHasher)" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;spacingLeft=6;verticalAlign=middle;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry x="1" relative="1" as="geometry">
            <mxPoint x="1045" y="826" as="sourcePoint" />
            <mxPoint x="1045" y="856" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1083" y="826" />
              <mxPoint x="1083" y="856" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="step_34" value="12: return matKhauHash" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1045" y="884" as="sourcePoint" />
            <mxPoint x="735" y="884" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step_35" value="13: EXEC dbo.sp_YMC_KhoiTaoAdmin @TenDangNhap, @MatKhauHash" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="735" y="928" as="sourcePoint" />
            <mxPoint x="1355" y="928" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step_36" value="14: BEGIN TRAN; sp_getapplock(N&apos;YMC_Account_Write&apos;)" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;spacingLeft=6;verticalAlign=middle;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry x="1" relative="1" as="geometry">
            <mxPoint x="1355" y="972" as="sourcePoint" />
            <mxPoint x="1355" y="1002" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1393" y="972" />
              <mxPoint x="1393" y="1002" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="step_37" value="15: Kiểm tra đã có ADMIN chưa (nếu có -&gt; THROW 50406)" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;spacingLeft=6;verticalAlign=middle;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry x="1" relative="1" as="geometry">
            <mxPoint x="1355" y="1030" as="sourcePoint" />
            <mxPoint x="1355" y="1060" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1393" y="1030" />
              <mxPoint x="1393" y="1060" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="step_38" value="16: INSERT TaiKhoan, TaiKhoanVaiTro(&apos;ADMIN&apos;); COMMIT" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;spacingLeft=6;verticalAlign=middle;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry x="1" relative="1" as="geometry">
            <mxPoint x="1355" y="1088" as="sourcePoint" />
            <mxPoint x="1355" y="1118" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1393" y="1088" />
              <mxPoint x="1393" y="1118" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="step_39" value="17: return MaTaiKhoan (IDENTITY)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1355" y="1146" as="sourcePoint" />
            <mxPoint x="735" y="1146" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step_40" value="18: return int maTaiKhoan" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="735" y="1190" as="sourcePoint" />
            <mxPoint x="425" y="1190" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step_41" value="19: daCoAdmin = true, xóa ô mật khẩu, tắt nút khởi tạo" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;spacingLeft=6;verticalAlign=middle;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
