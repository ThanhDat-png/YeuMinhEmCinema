          </mxGeometry>
        </mxCell>
        <mxCell id="step_22" value="3: SELECT EXISTS(TaiKhoanVaiTro JOIN VaiTro WHERE TenVaiTro=&apos;ADMIN&apos;)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="735" y="266" as="sourcePoint" />
            <mxPoint x="1355" y="266" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step_23" value="4: return 0 (chưa có Admin)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1355" y="310" as="sourcePoint" />
            <mxPoint x="735" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step_24" value="5: return false" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
