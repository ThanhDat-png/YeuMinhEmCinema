              <mxPoint x="463" y="428" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="step_26" value="7: Nhập (tenDangNhap, matKhau) &amp; Click btnKhoiTaoAdmin" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="115" y="472" as="sourcePoint" />
            <mxPoint x="425" y="472" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step_27" value="8: Kiểm tra ten.Length trong [3..50] và matKhau.Length &gt;= 12" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;spacingLeft=6;verticalAlign=middle;endArrow=block;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
