              <mxPoint x="463" y="558" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="frame_28" value="alt [Tên đăng nhập &lt; 3 ký tự HOẶC mật khẩu &lt; 12 ký tự]" style="shape=umlFrame;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1">
