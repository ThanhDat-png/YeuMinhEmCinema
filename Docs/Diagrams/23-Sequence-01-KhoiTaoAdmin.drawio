        </mxCell>
        <mxCell id="step_30" value="Hiển thị thông báo lỗi dữ liệu đầu vào, giữ nguyên Form" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;strokeColor=#000000;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
