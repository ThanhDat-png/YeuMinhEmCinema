@model TrangChuViewModel
@{
    ViewData["Title"] = "Khám phá điện ảnh";
}
<section class="cinema-spotlight container" aria-label="Phim nổi bật" data-spotlight>
    <div class="spotlight-landscape" aria-hidden="true"></div>
    <div class="spotlight-inner">
        <div class="spotlight-copy">
            @if (Model.PhimNoiBat.Count > 0)
            {
                @for (var i = 0; i < Model.PhimNoiBat.Count; i++)
                {
                    var phim = Model.PhimNoiBat[i];
                    <article class="spotlight-slide" id="tieu-diem-@i" hidden="@(i != 0)">
                        <p class="eyebrow">TIÊU ĐIỂM ĐIỆN ẢNH · @phim.TrangThai</p>
                        <h1>@phim.TenPhim</h1>
                        <p class="spotlight-meta">
                            <span class="spotlight-age">@phim.GioiHanTuoi</span>
                            <span>@phim.ThoiLuong phút</span>
                            <span>Khởi chiếu @phim.NgayKhoiChieu.ToString("dd/MM/yyyy")</span>
                        </p>
                        <p class="spotlight-description">Một câu chuyện mới đang chờ bạn trên màn ảnh rộng. Chọn suất chiếu và tận hưởng khoảnh khắc điện ảnh của riêng mình.</p>
                        <div class="spotlight-actions">
                            <a class="button" asp-controller="Phim" asp-action="ChiTiet" asp-route-id="@phim.MaPhim" asp-fragment="lich-chieu">Đặt vé ngay ↗</a>
                            <a class="button button-outline" asp-controller="Phim" asp-action="ChiTiet" asp-route-id="@phim.MaPhim">Xem chi tiết</a>
                        </div>
                    </article>
                }
            }
            else
            {
                <p class="eyebrow">YEUMINHEM CINEMA</p>
                <h1>Chạm vào cảm xúc.<br />Sống cùng điện ảnh.</h1>
                <p class="spotlight-description">Hẹn nhau tại rạp, cùng khám phá những câu chuyện trên màn ảnh rộng.</p>
                <a class="button" href="#phim">Khám phá phim ↗</a>
            }
        </div>
        @if (Model.PhimNoiBat.Count > 0)
        {
            <div class="spotlight-gallery">
                <p class="spotlight-gallery-label">LỰA CHỌN CHO TỐI NAY</p>
                <div class="spotlight-posters">
                    @for (var i = 0; i < Model.PhimNoiBat.Count; i++)
                    {
                        var phim = Model.PhimNoiBat[i];
                        <a class="spotlight-card @(i == 0 ? "is-active" : "")"
                           asp-controller="Phim" asp-action="ChiTiet" asp-route-id="@phim.MaPhim"
                           data-spotlight-choice="@i" aria-controls="tieu-diem-@i"
                           aria-label="Giới thiệu phim @phim.TenPhim">
                            <img class="slide-poster" src="@phim.AnhPoster" alt="Poster @phim.TenPhim" />
                            <span class="spotlight-card-caption">@phim.TenPhim</span>
                        </a>
                    }
                </div>
                <div class="spotlight-controls" hidden>
                    <span data-spotlight-counter aria-live="polite">1 / @Model.PhimNoiBat.Count</span>
                    <button type="button" data-spotlight-previous aria-label="Phim trước">←</button>
                    <button type="button" data-spotlight-next aria-label="Phim tiếp theo">→</button>
                </div>
            </div>
        }
    </div>
    <div class="spotlight-footnote"><span></span> Không gian điện ảnh của bạn <a href="#rap">Khám phá cụm rạp ↗</a></div>
</section>
<div class="container page-content home-page">
    @if (Model.Loi != null)
    {
        <div class="notice" role="alert">
            <h2>Dữ liệu tạm thời chưa sẵn sàng</h2>
            <p>@Model.Loi</p>
            <a href="/">Tải lại trang chủ</a>
        </div>
    }
    <section class="quick-booking" aria-labelledby="quick-booking-title">
        <div class="quick-booking-heading">
            <div><p class="eyebrow">HẸN MỘT BUỔI XEM PHIM</p><h2 id="quick-booking-title">Đặt vé nhanh</h2></div>
            <p>01 Chọn phim <span>→</span> 02 Chọn suất <span>→</span> 03 Chọn ghế</p>
        </div>
        <form asp-controller="Phim" asp-action="Lich" method="get" class="quick-booking-form">
            <div>
                <label for="quick-film">Bạn muốn xem phim gì?</label>
                <select id="quick-film" name="maPhim">
                    <option value="">Tất cả phim</option>
                    @foreach (var phim in Model.PhimNoiBat.Concat(Model.Phim).DistinctBy(p => p.MaPhim))
                    {
                        <option value="@phim.MaPhim">@phim.TenPhim</option>
                    }
                </select>
            </div>
            <div>
                <label for="quick-date">Ngày chiếu</label>
                <input id="quick-date" name="ngay" type="date" aria-describedby="quick-date-help" />
                <small id="quick-date-help">Để trống để xem suất gần nhất.</small>
            </div>
            <div class="quick-cinema">
                <span class="quick-label">Cụm rạp</span>
                <a asp-controller="Phim" asp-action="Rap">Chọn theo rạp ↗</a>
                <small>Hoặc lọc rạp ở bước chọn suất.</small>
            </div>
            <button class="button" type="submit">Tìm suất chiếu →</button>
        </form>
    </section>
    <section id="phim" aria-labelledby="movies-title">
        <div class="section-heading">
            <div>
                <p class="eyebrow">
                    CÂU CHUYỆN TIẾP THEO CỦA BẠN
                </p>
                <h2 id="movies-title">
                    Phim dành cho bạn
                </h2>
            </div>
        </div>
        <form method="get" action="/#phim" class="filters" data-loading>
            <div>
                <label for="tuKhoa">
                    Tên phim
                </label>
                <input id="tuKhoa" name="tuKhoa" maxlength="200" value="@Model.TuKhoa" placeholder="Nhập tên phim muốn tìm" />
            </div>
            <div>
                <label for="trangThai">
                    Trạng thái
                </label>
                <select id="trangThai" name="trangThai">
                    <option value="">
                        Tất cả phim
                    </option>
                    <option selected="@(Model.TrangThai == "Đang chiếu")">
                        Đang chiếu
                    </option>
                    <option selected="@(Model.TrangThai == "Sắp chiếu")">
                        Sắp chiếu
                    </option>
                </select>
            </div>
            <button class="button" type="submit">
                Tìm phim
            </button>
            <a href="/#phim">
                Xóa bộ lọc
            </a>
            <span class="loading" role="status" hidden>
                Đang tải danh sách phim…
            </span>
        </form>
        @if (Model.Loi == null)
        {
            <p class="muted">
                Tìm thấy @Model.TongKetQua phim.
            </p>
            @foreach (var trangThai in new[] { "Đang chiếu", "Sắp chiếu" })
            {
                var danhSach = Model.Phim.Where(p => p.TrangThai == trangThai).ToList();
                if (danhSach.Count > 0)
                {
                    <h3 class="group-title">
                        Phim @trangThai.ToLower()
                    </h3>
                    <div class="movie-grid">
                        @foreach (var phim in danhSach)
                        {
                            <article class="movie-card" id="phim-@phim.MaPhim">
                                <div class="poster-wrap">
                                    <img src="@phim.AnhPoster" alt="Poster @phim.TenPhim" loading="lazy" />
                                    <span class="age">
                                        @phim.GioiHanTuoi
                                    </span>
                                </div>
                                <div class="card-content">
                                    <p class="eyebrow">
                                        @phim.TrangThai
                                    </p>
                                    <h4>
                                        @phim.TenPhim
                                    </h4>
                                    <p>
                                        @phim.ThoiLuong phút
                                    </p>
                                    <p>
                                        Khởi chiếu @phim.NgayKhoiChieu.ToString("dd/MM/yyyy")
                                    </p>
                                    @if (phim.TrangThai == "Đang chiếu")
                                    {
                                        <a class="button" asp-controller="Phim" asp-action="ChiTiet" asp-route-id="@phim.MaPhim" asp-fragment="lich-chieu">Đặt vé ngay</a>
                                    }
                                    else
                                    {
                                        <a class="button button-outline" asp-controller="Phim" asp-action="ChiTiet" asp-route-id="@phim.MaPhim">Xem chi tiết</a>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
                else if (Model.Phim.Count > 0 &&
                    (Model.TrangThai == null || Model.TrangThai == trangThai))
                {
                    <h3 class="group-title">
                        Phim @trangThai.ToLower()
                    </h3>
                    <p class="muted">
                        Chưa có phim @trangThai.ToLower() phù hợp trên trang này.
                    </p>
                }
            }
            @if (Model.Phim.Count == 0)
            {
                <div class="notice">
                    <h3>
                        Chưa có phim phù hợp
                    </h3>
                    <p>
                        Thử đổi tên phim, xóa bộ lọc hoặc quay lại trang đầu.
                    </p>
                    <a href="/#phim">
                        Xem danh sách phim
                    </a>
                </div>
            }
            <nav class="pagination" aria-label="Phân trang phim">
                @if (Model.Trang > 1)
                {
                    <a asp-action="Index" asp-route-trang="@(Model.Trang - 1)" asp-route-tuKhoa="@Model.TuKhoa" asp-route-trangThai="@Model.TrangThai" asp-fragment="phim">
                        ← Trang trước
                    </a>
                }
                @if (Model.TongTrang > 0)
                {
                    <span>
                        Trang @Model.Trang / @Model.TongTrang
                    </span>
                }
                @if (Model.Trang < Model.TongTrang)
                {
                    <a asp-action="Index" asp-route-trang="@(Model.Trang + 1)" asp-route-tuKhoa="@Model.TuKhoa" asp-route-trangThai="@Model.TrangThai" asp-fragment="phim">
                        Trang sau →
                    </a>
                }
            </nav>
        }
    </section>
    <section id="rap" class="cinemas" aria-labelledby="cinemas-title">
        <p class="eyebrow">
            HẸN NHAU Ở RẠP
        </p>
        <h2 id="cinemas-title">
            Cụm rạp YeuMinhEm
        </h2>
        <p>
            Chọn không gian điện ảnh gần bạn và cùng nhau tận hưởng những câu chuyện mới.
        </p>
        <div class="cinema-grid">
            @foreach (var rap in Model.Rap)
            {
                <article class="cinema-card">
                    <span aria-hidden="true">
                        ↗
                    </span>
                    <h3>
                        @rap.TenRap
                    </h3>
                    <p>
                        @rap.DiaChi
                    </p>
                </article>
            }
        </div>
        @if (Model.Rap.Count == 0 && Model.Loi == null)
        {
            <p class="notice">
                Chưa có thông tin rạp đang hoạt động. Vui lòng quay lại sau.
            </p>
        }
    </section>
</div>
