@model DatVeModel
@{
    ViewData["Title"] = "Chọn bắp nước";
    decimal tienVe = 0;
}
<div class="container page-content">
    <h1>Bắp nước & combo</h1>
    <partial name="_Suat" model="Model" />
    <div asp-validation-summary="All" class="validation" role="alert"></div>
    <p>Bấm chọn món, sau đó nhập số lượng hoặc dùng nút − / +. Bạn có thể bỏ qua bước chọn bắp nước.</p>
    <ul>
        @foreach (var ma in Model.Ghe)
        {
            var ghe = Model.SoDo.AsEnumerable().FirstOrDefault(r => (int)r["MaGhe"] == ma);
            if (ghe != null && ghe["Gia"] != DBNull.Value)
            {
                tienVe += (decimal)ghe["Gia"];
                <li>@ghe["HangGhe"]@ghe["SoGhe"] · @HienThi.Tien(ghe["Gia"])</li>
            }
        }
    </ul>
    <p>Tiền vé dự kiến: <strong>@HienThi.Tien(tienVe)</strong></p>
    <form asp-action="GiuGhe" method="post" data-submit>
        <input asp-for="MaSuatChieu" type="hidden" />
        <input asp-for="MaYeuCau" type="hidden" />
        <input asp-for="HoTen" type="hidden" />
        <input asp-for="DienThoai" type="hidden" />
        @foreach (var ma in Model.Ghe)
        {
            <input name="Ghe" value="@ma" type="hidden" />
        }
        <div class="cinema-grid" data-fnb data-ticket-total="@tienVe.ToString(System.Globalization.CultureInfo.InvariantCulture)">
            @for (var i = 0; i < Model.Menu.Rows.Count; i++)
            {
                var row = Model.Menu.Rows[i];
                var soLuong = Model.Fnb.FirstOrDefault(f => f.MaSanPham == (int)row["MaSanPham"])?.SoLuong ?? 0;
                <article class="cinema-card fnb-card">
                    <h3>@row["TenSanPham"]</h3>
                    <button type="button" class="fnb-select" aria-controls="quantity-@i" aria-pressed="@(soLuong > 0 ? "true" : "false")" data-fnb-select>Chọn món</button>
                    <p>@row["Nhom"] · @HienThi.Tien(row["DonGia"])</p>
                    <input name="Fnb[@i].MaSanPham" value="@row["MaSanPham"]" type="hidden" />
                    <div id="quantity-@i" class="fnb-quantity">
                    <label for="fnb-@i">Số lượng @row["TenSanPham"]</label>
                    <div class="quantity-stepper">
                    <button type="button" data-quantity-step="-1" aria-label="Giảm số lượng @row["TenSanPham"]">−</button>
                    <input id="fnb-@i" name="Fnb[@i].SoLuong" type="number" min="0" max="99" value="@soLuong" data-price="@Convert.ToDecimal(row["DonGia"]).ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                    <button type="button" data-quantity-step="1" aria-label="Tăng số lượng @row["TenSanPham"]">+</button>
                    </div>
                    </div>
                    <p>Thành tiền: <output data-line-total>@HienThi.Tien(Convert.ToDecimal(row["DonGia"]) * soLuong)</output></p>
                </article>
            }
        </div>
        @if (Model.Menu.Rows.Count == 0)
        {
            <p class="notice">Chưa có sản phẩm đang bán. Bạn có thể tiếp tục chỉ mua vé.</p>
        }
        <p>Tổng dự kiến: <strong id="estimated-total">Xem tổng chính thức ở bước kiểm tra đơn</strong></p>
        <button type="submit" class="button">Giữ ghế & kiểm tra đơn</button>
    </form>
</div>
